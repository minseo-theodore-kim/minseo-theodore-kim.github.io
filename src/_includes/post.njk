---
layout: base.njk
---
<main class="wrap article">
  <a class="back" href="/">← {{ site.name }}</a>

  <h1>{{ title }}</h1>
  <p class="article-meta">
    <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
    <span class="dot">·</span><span>{{ content | readingTime }} min read</span>
    {% for t in tags | realTags %}<span class="dot">·</span><span class="tag{% if not loop.first %} alt{% endif %}">{{ t }}</span>{% endfor %}
  </p>

  {% if tldr %}
  <div class="lede" style="margin-top:2.75rem">
    <span class="eyebrow">The short version</span>
    <p>{{ tldr }}</p>
  </div>
  {% endif %}

  {% if data %}
  <div class="databox">
    <span class="eyebrow">Data &amp; method</span>
    <dl>
      {% for k, v in data %}<dt>{{ k }}</dt><dd>{{ v | dataValue | safe }}</dd>{% endfor %}
    </dl>
  </div>
  {% endif %}

  <div class="prose">
    {{ content | safe }}
  </div>

  {% set posts = collections.writing %}
  {% set idx = null %}
  {% for p in posts %}{% if p.url == page.url %}{% set idx = loop.index0 %}{% endif %}{% endfor %}

  <nav class="pager">
    <div>
      {% if idx != null and idx < (posts.length - 1) %}
        {% set prev = posts[idx + 1] %}
        <a href="{{ prev.url }}">
          <span class="eyebrow">← Previous</span>
          <span class="t">{{ prev.data.title }}</span>
        </a>
      {% else %}
        <span><span class="eyebrow">← Previous</span>
        <span class="t" style="color:var(--faint)">This is the first piece</span></span>
      {% endif %}
    </div>
    <div class="right">
      {% if idx != null and idx > 0 %}
        {% set next = posts[idx - 1] %}
        <a href="{{ next.url }}">
          <span class="eyebrow">Next →</span>
          <span class="t">{{ next.data.title }}</span>
        </a>
      {% else %}
        <span><span class="eyebrow">Next →</span>
        <span class="t" style="color:var(--faint)">Most recent piece</span></span>
      {% endif %}
    </div>
  </nav>

  <div class="backrow">
    <a class="btn" href="/">All writing</a>
  </div>
</main>
